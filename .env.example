# Example environment configuration — copy to .env or .local/.env and fill values.
# Never commit real tokens, private keys, or credentials to Git or Google Drive.

# --- Server & Ironic API ---
PULSAR_ENV=development
PULSAR_BIND_ADDR=0.0.0.0:8080
PULSAR_PUBLIC_URL=https://pulsar.example.com
PULSAR_TRUSTED_ORIGINS=https://app.example.com
PULSAR_API_GENERATION=1

# --- Authentication (Argon2id + JWT + Revocable Opaque Keys) ---
PULSAR_JWT_SECRET=
PULSAR_JWT_ACCESS_TTL_SECS=900
PULSAR_REFRESH_TTL_SECS=2592000
PULSAR_ADMIN_EMAIL=
PULSAR_ADMIN_INITIAL_PASSWORD=
PULSAR_CREDENTIAL_MASTER_KEY=

# --- PostgreSQL ---
DATABASE_URL=postgres://pulsar:change_me@127.0.0.1:5432/pulsar
DATABASE_MAX_CONNECTIONS=20

# --- Valkey (Redis-compatible state, locks & rate limiting) ---
VALKEY_URL=redis://127.0.0.1:6379
VALKEY_TLS=false

# --- NATS JetStream (Control Plane, Queues, Streams & Swarm) ---
NATS_URL=nats://127.0.0.1:4222
NATS_TLS_ENABLED=false
NATS_NKEY_SEED=
NATS_JWT=
NATS_CLUSTER_NAME=pulsar-cluster

# --- Boxer Daemon & Sandbox Runtime ---
BOXER_NODE_ID=boxer-local-01
BOXER_RUNTIME=docker
BOXER_ISOLATION=openshell
BOXER_OPENSHELL_GATEWAY_URL=
BOXER_SANDBOX_IMAGE=ghcr.io/natuleadan/pulsar-sandbox:latest
BOXER_MAX_CONCURRENT_BOXES=8
BOXER_WORKSPACE_ROOT=/var/lib/pulsar/boxes

# --- Traefik Ephemeral Preview Proxy ---
TRAEFIK_PREVIEW_ENABLED=true
TRAEFIK_PREVIEW_DOMAIN=preview.example.com
TRAEFIK_ACME_EMAIL=
TRAEFIK_VLAN_SUBNET=10.0.0.0/8

# --- LLM Providers (Optional host/proxy overrides; never hardcode in client) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPINFRA_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Third-Party Sandbox Providers (Client Third-Party Mode) ---
UPSTASH_BOX_API_KEY=
DAYTONA_API_KEY=
DAYTONA_API_URL=
INSTABOX_API_KEY=

# --- Cloud VPS Provisioning & Ephemeral E2E Testing ---
VPS_PROVIDER_API_BASE=
VPS_PROVIDER_API_KEY=
VPS_PROVIDER_PROJECT_ID=
VPS_PROVIDER_VLAN_ID=
VPS_PROVIDER_REGION=
VPS_PROVIDER_PLAN=
VPS_PROVIDER_SSH_KEY_PATH=.local/id_ed25519

# --- Observability (OpenTelemetry) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=pulsar-server
RUST_LOG=info,pulsar_server=debug,pulsar_boxer=debug

# --- Internal S3 / RustFS Artifact Storage ---
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=pulsar-artifacts
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PRESIGN_TTL_SECS=900

# --- Installation Identity & A2A ---
PULSAR_ORG_NAME=
PULSAR_INSTALLATION_ID=
PULSAR_IDENTITY_CODE=
PULSAR_IDENTITY_REGISTRAR_URL=
PULSAR_STRICT_INBOUND_WEBHOOKS=false
PULSAR_STRICT_OUTBOUND_EGRESS=true
