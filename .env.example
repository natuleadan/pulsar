# Environment Variables for Natuleadan Pulsar (Local & CI Contract)
# Local dev: copy to .env (git-ignored) and populate required values.
# CI/CD: sync required keys via `gh secret set <KEY> --repo natuleadan/pulsar` (fail-fast if missing).

# [var] Orchestrator environment (development | staging | production)
PULSAR_ENV=development
# [secret] Upstash Redis REST endpoint
UPSTASH_REDIS_REST_URL=CHANGE_ME
# [secret] Upstash Redis REST token
UPSTASH_REDIS_REST_TOKEN=CHANGE_ME
# [secret] Upstash QStash durable queue token
QSTASH_TOKEN=CHANGE_ME
# [secret] Better Stack telemetry source token
BETTER_STACK_SOURCE_TOKEN=CHANGE_ME
